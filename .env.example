# VYRO environment template
#
# Copy this file to `.env.local` for local development. The app launches
# without any of these values; credentials are only required by features
# that explicitly use them.
#
# IMPORTANT
# - Only variables prefixed with EXPO_PUBLIC_ are available in the app bundle.
# - EXPO_PUBLIC_ values are embedded in the compiled application and are not
#   secret. Never put provider API keys, service-role keys, or passwords here.
# - AI provider keys belong on the backend proxy, configured through server
#   environment variables or Expo Services, never in this mobile app.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Optional until accounts or cloud sync are implemented.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional until the AI explanation phase. This is a public endpoint URL,
# not a provider key. The backend proxy owns all AI credentials.
EXPO_PUBLIC_AI_PROXY_URL=

# Server-side only examples. Do not uncomment these in a mobile .env file.
# SUPABASE_SERVICE_ROLE_KEY=
# AI_PROVIDER_API_KEY=
